{
  "manifest_version": 3,
  "name": "TexGuard",
  "version": "1.1",
  "description": "TexGuard menggunakan AI untuk menyensor komentar toxic, spam, dan berbahaya secara otomatis di media sosial Anda.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.texguard.site/*"],
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*", 
        "*://*.x.com/*"         
      ],
      "js": [
        "src/shared/Config.js",
        "src/shared/Statistics.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
